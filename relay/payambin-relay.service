[Unit]
Description=PayamBin Relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/payambin-relay/payambin-relay -listen :8443 -host YOUR_SERVER_IP -dir /opt/payambin-relay
WorkingDirectory=/opt/payambin-relay
Restart=always
RestartSec=3
User=root
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
